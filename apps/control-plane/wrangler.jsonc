{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workerdeck-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  // Local development defaults. The interactive installer (`npx @workerdeck/cli`)
  // generates a fully populated production config with your account, D1, and
  // token identifiers. To deploy manually instead:
  //   1. `npx wrangler d1 create workerdeck` and paste the id below.
  //   2. Set the three Worker secrets (see docs/installation.md):
  //      CLOUDFLARE_API_TOKEN, CLOUDFLARE_BUILD_TOKEN, GITHUB_APP_PRIVATE_KEY.
  //   3. Put the Worker behind Cloudflare Access, set DASHBOARD_ORIGIN to the
  //      dashboard origin, then run `npm run deploy` from the repository root.
  "vars": {
    "ENVIRONMENT": "development",
    "AUTH_MODE": "development",
    "DASHBOARD_ORIGIN": "http://127.0.0.1:5173",
    "CLOUDFLARE_ACCOUNT_NAME": "Local Cloudflare",
    "CLOUDFLARE_BUILD_TOKEN_ID": "replace-with-the-dedicated-build-token-id",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workerdeck",
      // Required for remote deploys. Local `wrangler dev` ignores it.
      // "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../dashboard/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
}
